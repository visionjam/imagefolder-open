    <string name="about_licenses_close">Close</string>
    <string name="about_disclaimer_title">Disclaimer</string>
    <string name="about_disclaimer">This app is for technical research and personal backup only. Do not use it to distribute illegal content or infringe others\' rights. You are responsible for your actions.</string>
    <string name="about_open_source_title">About this project</string>
    <string name="about_open_source">An independent open-source reimplementation of the discontinued Image Folder app. All code and assets were rewritten; it is not affiliated with the original author. UI built with Material Design 3 and licensed under GPL-3.0.</string>
    <string name="about_license">License: GNU GPL v3.0</string>
    <string name="about_project_url">https://github.com/visionjam/imagefolder-open</string>
    <string name="about_project_open">Open on GitHub</string>
    <string name="about_archives_title">Archive support</string>
    <string name="about_format_title">Data format</string>
    <string name="about_format">PNG stores a private tpWj chunk (JSON header + 0x00 + data, CRC32 per the PNG spec); JPEG uses APP15 segments; WebP uses a private RIFF chunk named IFBW. Compressed or encrypted payloads use the IFB2 envelope.</string>
    <string name="about_carrier_title">Carrier formats</string>
    <string name="about_carrier">Output follows the cover image: PNG, JPEG and WebP are preserved; HEIC/AVIF and other containers are converted to PNG. JPEG/WebP carriers require this app; the original v1.1 only reads PNG.</string>
    <string name="about_tank_note">Output names follow the original style: Tank_timestamp.png / .jpg / .webp</string>
