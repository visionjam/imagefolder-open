    <string name="about_licenses_dialog_title">开源许可</string>
    <string name="about_licenses_body">本应用：GNU GPL v3.0\n\nAndroidX、Jetpack Compose、Kotlin：Apache License 2.0\n\nApache Commons Compress / IO / Lang / Codec、zip4j、kotlinx.coroutines、kotlinx.serialization：Apache License 2.0\n\nXZ for Java：Public Domain\n\n完整许可证文本见项目仓库的 LICENSE 文件及各依赖仓库。</string>
    <string name="about_licenses_close">关闭</string>
    <string name="about_disclaimer_title">免责声明</string>
    <string name="about_disclaimer">本应用仅供技术研究与个人备份使用。请勿用于传播违法内容或侵犯他人权益，使用者的行为及后果由使用者自行承担。</string>
    <string name="about_open_source_title">关于本项目</string>
    <string name="about_open_source">本项目是针对已停止维护的原应用「图片文件夹」的独立开源重实现，代码与素材全部重写，与原作者无关。界面采用 Material Design 3，采用 GPL-3.0 许可证开源。</string>
    <string name="about_license">许可证：GNU GPL v3.0</string>
    <string name="about_project_url">https://github.com/visionjam/imagefolder-open</string>
    <string name="about_project_open">在 GitHub 打开</string>
    <string name="about_archives_title">解压支持</string>
    <string name="about_format_title">数据格式</string>
    <string name="about_format">PNG 使用私有数据块 tpWj（JSON 头 + 0x00 + 数据，CRC32 遵循 PNG 规范）；JPEG 使用 APP15 段；WebP 使用私有 RIFF 块 IFBW。压缩或加密内容统一使用 IFB2 封装。</string>
    <string name="about_carrier_title">载体格式</string>
    <string name="about_carrier">输出格式跟随表图：PNG、JPEG、WebP 原样保留；HEIC/AVIF 等其他格式会转为 PNG。JPEG/WebP 载体需要本应用提取，原版 v1.1 只支持 PNG。</string>
    <string name="about_tank_note">输出文件名沿用原版风格：Tank_时间戳.png / .jpg / .webp</string>
    <string name="about_expand">展开</string>
